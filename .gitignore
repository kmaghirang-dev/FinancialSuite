# =========================================================
# Universal .gitignore — .NET (multi-project solutions)
# + React / Angular / Node frontends
# Patterns without a leading "/" match at any folder depth,
# so every project / class library in the solution is covered.
# =========================================================

# ---------- .NET build output ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml.user

# ---------- Visual Studio ----------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
