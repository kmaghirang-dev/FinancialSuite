# ---------- Rider / JetBrains ----------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ---------- NuGet ----------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# ---------- Tests / coverage ----------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage/
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# ---------- Node / React / Angular ----------
node_modules/
dist/
build/
out/
.angular/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo

# Blazor / ASP.NET static bundles generated at build
**/wwwroot/dist/
**/wwwroot/lib/

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
secrets.json
# Uncomment if you keep local-only settings out of the repo:
# appsettings.Development.json
# appsettings.Local.json

# ---------- Databases (local) ----------
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3

# ---------- OS junk ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
/scripts

# Application logs
[Ll]ogs/
